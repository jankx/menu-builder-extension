{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/polymorphic-menu",
    "version": "1.0.1",
    "title": "Polymorphic Menu Builder",
    "category": "jankx",
    "description": "Xây dựng menu điều hướng phẳng (mega, half-mega, dropdown, flyout) với drawer mobile và thanh sidebar dọc ngay trong editor.",
    "keywords": [
        "menu",
        "navigation",
        "mega menu",
        "flyout",
        "polymorphic"
    ],
    "textdomain": "jankx",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "viewScript": "file:./view.js",
    "attributes": {
        "schema": {
            "type": "object",
            "default": {
                "schemaVersion": "2.5.0-gutenberg",
                "blockName": "core/navigation-polymorphic-builder",
                "attributes": {
                    "menuTitle": "Primary Header Navigation",
                    "brandName": "Max Mega Menu",
                    "brandLogo": "",
                    "verticalWidth": 300,
                    "ctaLabel": "Get Pro",
                    "ctaUrl": "/pro",
                    "orientation": "horizontal",
                    "verticalExpandMode": "flyout-right",
                    "stickyHeader": true,
                    "mobileTransform": "push-in-left",
                    "widescreenMaxWidth": 1380,
                    "surfaceTheme": "light",
                    "gapPx": 28
                },
                "items": [
                    {
                        "id": "nav_features",
                        "label": "Features",
                        "url": "/features",
                        "submenuType": "mega",
                        "layoutMode": "grid",
                        "columnsCount": 2,
                        "widthPreset": "full",
                        "trigger": "hover",
                        "columns": [
                            {
                                "id": "col_f1",
                                "title": "BUILD",
                                "span": 1,
                                "blocks": [
                                    {
                                        "id": "b_101",
                                        "blockName": "core/heading",
                                        "attributes": {
                                            "title": "BUILD",
                                            "level": 4
                                        }
                                    },
                                    {
                                        "id": "b_102",
                                        "blockName": "core/navigation-link",
                                        "attributes": {
                                            "title": "Mega menus",
                                            "description": "Columns, rows and widgets",
                                            "url": "/features/mega-menus"
                                        }
                                    }
                                ]
                            },
                            {
                                "id": "col_f2",
                                "title": "STYLE & MOBILE",
                                "span": 1,
                                "blocks": [
                                    {
                                        "id": "b_201",
                                        "blockName": "core/heading",
                                        "attributes": {
                                            "title": "STYLE & MOBILE",
                                            "level": 4
                                        }
                                    },
                                    {
                                        "id": "b_202",
                                        "blockName": "core/navigation-link",
                                        "attributes": {
                                            "title": "Theme editor",
                                            "description": "100+ styling settings",
                                            "url": "/features/theme-editor"
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "nav_documentation",
                        "label": "Documentation",
                        "url": "/documentation",
                        "submenuType": "dropdown",
                        "layoutMode": "list",
                        "columnsCount": 1,
                        "widthPreset": "auto",
                        "trigger": "hover",
                        "columns": [
                            {
                                "id": "col_s1",
                                "title": "GETTING STARTED",
                                "span": 1,
                                "blocks": [
                                    {
                                        "id": "b_s1",
                                        "blockName": "core/navigation-link",
                                        "attributes": {
                                            "title": "Installation & Setup Guide",
                                            "url": "/docs/install"
                                        }
                                    },
                                    {
                                        "id": "b_s2",
                                        "blockName": "core/navigation-link",
                                        "attributes": {
                                            "title": "Configuring Mobile Drawer",
                                            "url": "/docs/mobile"
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "nav_support",
                        "label": "Support",
                        "url": "/support",
                        "submenuType": "none",
                        "layoutMode": "list",
                        "columnsCount": 1,
                        "widthPreset": "auto",
                        "trigger": "hover",
                        "columns": []
                    }
                ]
            }
        }
    },
    "supports": {
        "html": false,
        "anchor": true,
        "align": [
            "wide",
            "full"
        ]
    }
}