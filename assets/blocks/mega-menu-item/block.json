{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/mega-menu-item",
    "version": "1.0.0",
    "title": "Mega Menu Item",
    "category": "jankx",
    "parent": ["jankx/mega-menu"],
    "description": "Individual menu item with mega menu, flyout, dropdown support",
    "keywords": ["menu", "item", "mega", "flyout", "dropdown"],
    "textdomain": "jankx",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./editor.css",
    "style": "file:./style.css",
    "attributes": {
        "itemId": {
            "type": "string",
            "default": ""
        },
        "label": {
            "type": "string",
            "default": "Menu Item"
        },
        "url": {
            "type": "string",
            "default": "#"
        },
        "menuType": {
            "type": "string",
            "default": "link"
        },
        "layout": {
            "type": "string",
            "default": "list"
        },
        "columns": {
            "type": "number",
            "default": 2
        },
        "icon": {
            "type": "string",
            "default": ""
        },
        "imageUrl": {
            "type": "string",
            "default": ""
        },
        "description": {
            "type": "string",
            "default": ""
        },
        "badge": {
            "type": "string",
            "default": ""
        },
        "badgeColor": {
            "type": "string",
            "default": "blue"
        },
        "submenuWidth": {
            "type": "string",
            "default": "auto"
        },
        "align": {
            "type": "string",
            "default": "left"
        },
        "cardStyle": {
            "type": "string",
            "default": "detailed"
        },
        "target": {
            "type": "string",
            "default": "_self"
        },
        "rel": {
            "type": "string",
            "default": ""
        },
        "cssClass": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "anchor": true,
        "customClassName": true,
        "html": false,
        "multiple": true,
        "reusable": false
    }
}
